# === Django ===
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=False

# === PostgreSQL ===
POSTGRES_DB=cekicim
POSTGRES_USER=cekicim
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# === Redis / Celery ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# === JWT ===
JWT_SECRET=change-me-to-a-random-jwt-secret

# === Hosts / CORS ===
ALLOWED_HOSTS=localhost,127.0.0.1,kurtaricim.com.tr,www.kurtaricim.com.tr,api.kurtaricim.com.tr
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost,https://kurtaricim.com.tr,https://www.kurtaricim.com.tr,https://api.kurtaricim.com.tr
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:5173,https://kurtaricim.com.tr,https://www.kurtaricim.com.tr,https://api.kurtaricim.com.tr

# === Güvenlik ===
# Gerçek bir domain + güvenilir TLS sertifikası (Let's Encrypt) ile prod'a
# çıkarken true yapın: HSTS, secure-cookie ve HTTPS yönlendirmesini aktif eder.
SITE_USES_HTTPS=false

# === Harita / Rota Servisleri ===
OSRM_URL=http://osrm:5000
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Google Cloud Console'dan alınan anahtar. Bu anahtarda şunlar açık olmalı:
# Maps JavaScript API, Places API, Geocoding API. Boş bırakılırsa haritalar
# ve adres arama Nominatim/OpenStreetMap'e geri döner.
GOOGLE_MAPS_API_KEY=

# === Frontend ===
# Boş bırakın: frontend, API/WS adresini tarayıcının o an kullandığı origin'den
# (http/https, host) kendisi türetir — Caddy zaten aynı origin üzerinden proxy
# yapıyor. Sadece frontend'i API'den FARKLI bir domain'de servis ediyorsanız
# doldurun (örn. VITE_API_BASE_URL=https://api.ornek.com/api).
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# === PayTR iFrame API (ödeme) ===
# Değerler PayTR Mağaza Paneli > Destek & Kurulum > Entegrasyon Bilgileri >
# "API Entegrasyon Bilgileri" bölümündedir (yalnızca Ana Kullanıcı ve Teknik
# Kullanıcı görebilir). Bu üç değer GİZLİDİR: yalnızca sunucudaki .env
# dosyasına yazılır, repoya/frontend'e/loglara asla girmez.
#   PAYTR_MERCHANT_ID    -> Mağaza No
#   PAYTR_MERCHANT_KEY   -> Mağaza Parola
#   PAYTR_MERCHANT_SALT  -> Mağaza Gizli Anahtar
# Üçü de boşken kart ile ödeme uçları HTTP 503 döner; sitenin geri kalanı
# etkilenmez (nakit ve havale/EFT akışları çalışmaya devam eder).
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# Test modu. PayTR canlı mod onayı verene kadar true kalmalı.
# true  -> işlem gerçek para hareketi oluşturmaz (ödeme sayfasındaki hazır
#          test kartlarıyla denenir)
# false -> GERÇEK TAHSİLAT. Yalnızca PayTR canlı mod onayı geldikten sonra.
PAYTR_TEST_MODE=true

# PayTR'nin hata nedenini açık döndürmesi (entegrasyon sırasında 1 yararlı,
# canlıda kapalı tutulur).
PAYTR_DEBUG_ON=false

# Ödeme formunun geçerlilik süresi (dakika). Boş bırakılırsa PayTR 30 kabul eder.
PAYTR_TIMEOUT_LIMIT=30

# Taksit ayarları: 1 = taksit tamamen kapalı. max_installment 0 = mağazaya
# tanımlı en yüksek taksit, 2..12 = sabit üst sınır.
PAYTR_NO_INSTALLMENT=0
PAYTR_MAX_INSTALLMENT=0

# Para birimi: TL/TRY, EUR, USD, GBP, RUB.
PAYTR_CURRENCY=TL

# Ödeme sonrası kullanıcının döndüğü sayfalar. Varsayılan olarak
# SITE_BASE_URL'den üretilir (/odeme/basarili ve /odeme/basarisiz).
# Bu sayfalar BİLGİLENDİRME amaçlıdır; ödeme kanıtı değildir.
#
# DİKKAT — ALAN ADI: Siteyi fiilen sunan alan adı kurtarıcım.com.tr'dir ve
# DNS'te yalnızca onun PUNYCODE karşılığı bu sunucuya işaret eder:
#   xn--kurtarcm-ykbb.com.tr   -> bu sunucu (Cloudflare arkasında, HTTP 200)
#   kurtaricim.com.tr          -> ŞU AN BAŞKA bir IP'ye gidiyor (HTTP 403)
# Bu yüzden varsayılan punycode biçimidir. ASCII alan adını kullanmak,
# ödeme tahsil edildikten sonra müşterinin erişilemeyen bir sayfaya
# düşmesine yol açar. ASCII alan adı ileride bu sunucuya yönlendirilirse
# aşağıdaki satırı güncelleyin.
SITE_BASE_URL=https://xn--kurtarcm-ykbb.com.tr
# PAYTR_MERCHANT_OK_URL=https://xn--kurtarcm-ykbb.com.tr/odeme/basarili
# PAYTR_MERCHANT_FAIL_URL=https://xn--kurtarcm-ykbb.com.tr/odeme/basarisiz

# ÖNEMLİ — Bildirim URL'si (callback) PayTR panelinden tanımlanır, ortam
# değişkeninden değil. Panelde "Bildirim URL" alanına şu adres yazılmalıdır:
#   https://xn--kurtarcm-ykbb.com.tr/api/payments/paytr/callback/
# Bu adres dışarıdan erişilebilir, oturum/IP kısıtı olmayan ve geçerli bir
# TLS sertifikası sunan bir adres olmalıdır. (Doğrulandı: bu alan adı üzerinden
# /api/ uçlarına dışarıdan erişilebiliyor.)

# === Seed ===
RUN_SEED=true

# === Domain (Caddy) ===
SITE_DOMAIN=kurtaricim.com.tr
