# =============================================================================
#  STAGING ORTAM DEĞİŞKENLERİ
#  Kopyalayın:  cp infra/staging/.env.staging.example infra/staging/.env.staging
#  .env.staging GIT'E GİRMEZ (bkz. .gitignore).
# =============================================================================

# --- Django ---
DJANGO_SECRET_KEY=staging-icin-rastgele-bir-deger-uretin
DEBUG=False

# --- Veritabanı (üretimden AYRI) ---
POSTGRES_DB=cekicim_staging
POSTGRES_USER=cekicim
POSTGRES_PASSWORD=staging-pass-degistirin
POSTGRES_PORT=5432

JWT_SECRET=staging-icin-rastgele-bir-jwt-secret

# --- Tünel alan adı ---
# cloudflared tüneli çalıştırınca verdiği adrese göre DOLDURUN, ör:
#   ornek-rastgele-ad.trycloudflare.com
# ALLOWED_HOSTS'a ve CSRF/CORS'a aynı adı yazın (şemasız / şemalı).
STAGING_HOST=degistirin.trycloudflare.com
ALLOWED_HOSTS=localhost,127.0.0.1,degistirin.trycloudflare.com
CORS_ALLOWED_ORIGINS=https://degistirin.trycloudflare.com
CSRF_TRUSTED_ORIGINS=https://degistirin.trycloudflare.com

# Tünel HTTPS sonlandırdığı için true.
SITE_USES_HTTPS=true

# PayTR dönüş adresleri ve iFrame sayfası bu adresten servis edilir.
SITE_BASE_URL=https://degistirin.trycloudflare.com

# Staging'de demo hesap oluşturulmasın; test verisini elle yaratacağız.
RUN_SEED=false

# --- PayTR ---
# Değerler PayTR Paneli > Destek & Kurulum > Entegrasyon Bilgileri altındadır.
# BU DOSYAYA yazın; repoya GİRMEZ.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# Test modu: gerçek para hareketi OLMAZ. Canlı mod onayı gelene kadar true.
PAYTR_TEST_MODE=true
# Entegrasyon sırasında PayTR'nin hata nedenini açık görmek için:
PAYTR_DEBUG_ON=true
PAYTR_TIMEOUT_LIMIT=30
PAYTR_NO_INSTALLMENT=0
PAYTR_MAX_INSTALLMENT=0
PAYTR_CURRENCY=TL

# Staging'de harita/dış servisler gerekmez.
GOOGLE_MAPS_API_KEY=
STAGING_PORT=8096
